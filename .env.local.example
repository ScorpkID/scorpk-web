# Mismo proyecto de Supabase que ya usa la extensión de VS Code — valores
# en c:\Users\crist\OneDrive\Desktop\Scorpk\src\auth\supabaseConfig.ts
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dashboard de Supabase > Project Settings > API > service_role (secreta,
# nunca la expongas al cliente ni la pegues en el chat)
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard de Stripe (modo prueba) > Developers > API keys
STRIPE_SECRET_KEY=

# Dashboard de Stripe > Developers > Webhooks > tu endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=

# Dashboard de Stripe > Product catalog > Scorpk Pro > el Price ID (price_...)
NEXT_PUBLIC_STRIPE_PRICE_ID=

# URL pública del sitio (para armar los redirect de OAuth/Checkout)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Clave de Fireworks AI para el servidor intermedio de la app Android (/api/ai/chat).
# Va SOLO aquí y en las variables de entorno del hosting; nunca dentro de la app.
FIREWORKS_API_KEY=

# Opcional. Con "true", el servidor intermedio de IA solo atiende a suscriptores Pro activos.
AI_REQUIRE_PRO=
